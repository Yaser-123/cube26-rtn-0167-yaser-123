ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your API key is not scoped to a workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=
# Optional tuning (defaults shown)
RTN_MODEL=claude-opus-5-5
RTN_EFFORT=low
RTN_MAX_IMAGE_EDGE=1024
# Public API keys, each mapped to one client account: key:org,key:org
RTN_API_KEYS=change-me-alpha:org_demo_alpha,change-me-bravo:org_demo_bravo
RTN_RATE_LIMIT_PER_HOUR=30
# Hard cap on billed model calls per UTC day (cache hits are free)
RTN_DAILY_CALL_CAP=300
